# Development example only. Production must supply an absolute persistent SQLite path.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-strong-random-secret-at-least-32-characters"
AUTH_COOKIE_NAME="maxpase_session"
AUTH_COOKIE_SECURE="false"
# Production: AUTH_COOKIE_SECURE=true, a generated AUTH_SECRET, and canonical HTTPS origin.
# APP_ORIGIN="https://your-reviewed-domain.example"
SIA_PROVIDER="deterministic"
# Optional development bootstrap password, supplied privately. New seeds otherwise
# generate an undisclosed random password; existing accounts are never overwritten.
# DEV_BOOTSTRAP_PASSWORD is forbidden in production deployment configuration.
# Communication secrets are supplied by deployment, never business configuration.
# Bind a credential to one integration and organization before resolution:
# MAXPASE_CREDENTIAL_BINDING_<integration-id>=<organization-id>:<environment-key>
# Live email / TalkinLabs / private document delivery remain NOT CONFIGURED.
# Boss provisioning is explicit. Supply BOSS_PIN privately only to scripts/provision-boss.ts;
# it must be exactly six numeric digits. Remove it from the process after provisioning.
# Never commit or print its value. The web application verifies the stored bcrypt hash.
BOSS_EMAIL="boss@maxpase.com"

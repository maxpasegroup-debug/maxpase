generator client {
  provider = "prisma-client-js"
}

model NiceJobsIncentivePolicy {
  id String @id @default(cuid())
  companyId String
  company Organization @relation("IncentiveCompany", fields: [companyId], references: [id], onDelete: Restrict)
  divisionId String
  division Organization @relation("IncentiveDivision", fields: [divisionId], references: [id], onDelete: Restrict)
  jobVersionId String
  jobVersion NiceJobsVersion @relation(fields: [jobVersionId], references: [id], onDelete: Restrict)
  name String
  versions NiceJobsIncentiveVersion[]
  earnings NiceJobsIncentiveEarning[]
  periods NiceJobsSettlementPeriod[]
  createdAt DateTime @default(now())
  @@index([companyId, divisionId, jobVersionId, id])
}

model NiceJobsIncentiveVersion {
  id String @id @default(cuid())
  policyId String
  policy NiceJobsIncentivePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  number Int
  revision Int @default(0)
  status String @default("DRAFT")
  ownerUserId String
  owner User @relation("IncentiveOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  reviewerUserId String?
  reviewer User? @relation("IncentiveReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  reviewedAt DateTime?
  currency String
  effectiveAt DateTime
  expiresAt DateTime?
  definition String
  publishedAt DateTime?
  createdAt DateTime @default(now())
  earnings NiceJobsIncentiveEarning[]
  adjustments NiceJobsWalletAdjustment[]
  periods NiceJobsSettlementPeriod[]
  @@unique([policyId, number])
  @@index([policyId, status, effectiveAt, id])
}

model NiceJobsIncentiveEarning {
  id String @id @default(cuid())
  assignmentId String
  assignment NiceJobsAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  policyId String
  policy NiceJobsIncentivePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  policyVersionId String
  policyVersion NiceJobsIncentiveVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  snapshotId String
  snapshot NiceJobsPerformanceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  periodStart DateTime
  periodEnd DateTime
  currency String
  amountMinor BigInt?
  eligibility String
  calculation String
  status String @default("CALCULATED")
  revision Int @default(0)
  requestId String? @unique
  request OperationalRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  creatorUserId String
  creator User @relation(fields: [creatorUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  ledger NiceJobsWalletLedger?
  @@unique([assignmentId, policyId, periodStart, periodEnd])
  @@index([assignmentId, status, currency, id])
  @@index([policyVersionId, status, id])
}

model NiceJobsWallet {
  id String @id @default(cuid())
  assignmentId String
  assignment NiceJobsAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  currency String
  status String @default("OPEN")
  revision Int @default(0)
  creatorUserId String
  creator User @relation(fields: [creatorUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  ledger NiceJobsWalletLedger[]
  adjustments NiceJobsWalletAdjustment[]
  statements NiceJobsSettlementStatement[]
  exceptions NiceJobsFinanceException[]
  @@unique([assignmentId, currency])
}

model NiceJobsWalletAdjustment {
  id String @id @default(cuid())
  walletId String
  wallet NiceJobsWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  policyVersionId String
  policyVersion NiceJobsIncentiveVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  direction String
  amountMinor BigInt
  reason String
  description String
  privateNote String?
  reversalProposal NiceJobsWalletReversalProposal?
  status String @default("DRAFT")
  revision Int @default(0)
  requestId String? @unique
  request OperationalRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  creatorUserId String
  creator User @relation(fields: [creatorUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  ledger NiceJobsWalletLedger?
  @@index([walletId, status, id])
}

model NiceJobsWalletReversalProposal {
  id String @id @default(cuid())
  adjustmentId String @unique
  adjustment NiceJobsWalletAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  ledgerId String
  ledger NiceJobsWalletLedger @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  @@index([ledgerId])
}

model NiceJobsWalletLedger {
  reversalProposals NiceJobsWalletReversalProposal[]
  id String @id @default(cuid())
  walletId String
  wallet NiceJobsWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  type String
  amountMinor BigInt
  currency String
  status String @default("POSTED")
  earningId String? @unique
  earning NiceJobsIncentiveEarning? @relation(fields: [earningId], references: [id], onDelete: Restrict)
  adjustmentId String? @unique
  adjustment NiceJobsWalletAdjustment? @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  statementId String? @unique
  statement NiceJobsSettlementStatement? @relation("SettlementDebit", fields: [statementId], references: [id], onDelete: Restrict)
  reversesId String? @unique
  reverses NiceJobsWalletLedger? @relation("WalletReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversal NiceJobsWalletLedger? @relation("WalletReversal")
  reference String @unique
  description String
  actorUserId String
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  lines NiceJobsSettlementLine[]
  @@index([walletId, type, createdAt, id])
}

model NiceJobsSettlementPeriod {
  id String @id @default(cuid())
  policyId String
  policy NiceJobsIncentivePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  policyVersionId String
  policyVersion NiceJobsIncentiveVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  from DateTime
  until DateTime
  currency String
  status String @default("OPEN")
  revision Int @default(0)
  requestId String? @unique
  request OperationalRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  creatorUserId String
  creator User @relation(fields: [creatorUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  approvedAt DateTime?
  closedAt DateTime?
  statements NiceJobsSettlementStatement[]
  @@unique([policyId, from, until])
  @@index([policyVersionId, status, from, id])
}

model NiceJobsSettlementStatement {
  id String @id @default(cuid())
  periodId String
  period NiceJobsSettlementPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  walletId String
  wallet NiceJobsWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  currency String
  amountMinor BigInt
  snapshot String
  status String @default("REVIEW")
  createdAt DateTime @default(now())
  lines NiceJobsSettlementLine[]
  debit NiceJobsWalletLedger? @relation("SettlementDebit")
  payout NiceJobsPayoutIntent?
  @@unique([periodId, walletId])
  @@index([walletId, status, id])
}

model NiceJobsSettlementLine {
  id String @id @default(cuid())
  statementId String
  statement NiceJobsSettlementStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)
  ledgerId String
  ledger NiceJobsWalletLedger @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  activeLedgerId String? @unique
  amountMinor BigInt
  @@unique([statementId, ledgerId])
  @@index([ledgerId])
}

model NiceJobsPayoutIntent {
  id String @id @default(cuid())
  statementId String @unique
  statement NiceJobsSettlementStatement @relation(fields: [statementId], references: [id], onDelete: Restrict)
  amountMinor BigInt
  currency String
  status String @default("PROVIDER_NOT_CONFIGURED")
  reference String @unique
  providerReference String? @unique
  creatorUserId String
  creator User @relation(fields: [creatorUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([status, createdAt, id])
}

model NiceJobsFinanceException {
  id String @id @default(cuid())
  companyId String
  company Organization @relation("FinanceExceptionCompany", fields: [companyId], references: [id], onDelete: Restrict)
  divisionId String
  division Organization @relation("FinanceExceptionDivision", fields: [divisionId], references: [id], onDelete: Restrict)
  walletId String?
  wallet NiceJobsWallet? @relation(fields: [walletId], references: [id], onDelete: Restrict)
  code String
  summary String
  reference String @unique
  actorUserId String
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@index([companyId, divisionId, createdAt, id])
}

model NiceJobsPerformanceFramework {
  id String @id @default(cuid())
  companyId String
  company Organization @relation("PerformanceCompany", fields: [companyId], references: [id], onDelete: Restrict)
  divisionId String
  division Organization @relation("PerformanceDivision", fields: [divisionId], references: [id], onDelete: Restrict)
  jobVersionId String
  jobVersion NiceJobsVersion @relation(fields: [jobVersionId], references: [id], onDelete: Restrict)
  name String
  versions NiceJobsPerformanceVersion[]
  createdAt DateTime @default(now())
  @@index([companyId, divisionId, jobVersionId, id])
}

model NiceJobsPerformanceVersion {
  id String @id @default(cuid())
  frameworkId String
  framework NiceJobsPerformanceFramework @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  number Int
  revision Int @default(0)
  status String @default("DRAFT")
  ownerUserId String
  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  period String
  timezone String
  effectiveAt DateTime
  definition String
  publishedAt DateTime?
  createdAt DateTime @default(now())
  snapshots NiceJobsPerformanceSnapshot[]
  @@unique([frameworkId, number])
  @@index([frameworkId, status, effectiveAt, id])
}

model NiceJobsPerformanceSnapshot {
  incentiveEarnings NiceJobsIncentiveEarning[]
  id String @id @default(cuid())
  assignmentId String
  assignment NiceJobsAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  frameworkVersionId String
  frameworkVersion NiceJobsPerformanceVersion @relation(fields: [frameworkVersionId], references: [id], onDelete: Restrict)
  periodStart DateTime
  periodEnd DateTime
  revision Int @default(0)
  supersedesId String? @unique
  supersedes NiceJobsPerformanceSnapshot? @relation("PerformanceCorrection", fields: [supersedesId], references: [id], onDelete: Restrict)
  correction NiceJobsPerformanceSnapshot? @relation("PerformanceCorrection")
  correctionReason String?
  results String
  status String
  generatedByUserId String
  generatedBy User @relation(fields: [generatedByUserId], references: [id], onDelete: Restrict)
  generatedAt DateTime @default(now())
  reviews NiceJobsPerformanceReview[]
  attention NiceJobsPerformanceAttention[]
  pips NiceJobsPip[]
  @@unique([assignmentId, frameworkVersionId, periodStart, periodEnd, revision])
  @@index([assignmentId, periodEnd, id])
  @@index([frameworkVersionId, status, periodEnd, id])
}

model NiceJobsPerformanceReview {
  id String @id @default(cuid())
  snapshotId String
  snapshot NiceJobsPerformanceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  reviewerUserId String
  reviewer User @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)
  feedback String
  privateNote String?
  released Boolean @default(false)
  followup String?
  supportTaskId String?
  supportTask Task? @relation(fields: [supportTaskId], references: [id], onDelete: Restrict)
  acknowledgedAt DateTime?
  createdAt DateTime @default(now())
  @@index([snapshotId, released, id])
}

model NiceJobsPerformanceAttention {
  id String @id @default(cuid())
  snapshotId String
  snapshot NiceJobsPerformanceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  metricKey String
  status String @default("OPEN")
  revision Int @default(0)
  reason String
  resolution String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@unique([snapshotId, metricKey])
  @@index([status, snapshotId, id])
}

model NiceJobsPip {
  id String @id @default(cuid())
  assignmentId String
  assignment NiceJobsAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  snapshotId String
  snapshot NiceJobsPerformanceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  managerId String
  manager Person @relation(fields: [managerId], references: [id], onDelete: Restrict)
  title String
  reason String
  workerMessage String
  privateNote String?
  objectives String
  supportActions String
  startAt DateTime
  reviewAt DateTime
  status String @default("DRAFT")
  revision Int @default(0)
  released Boolean @default(false)
  requiredAck Boolean @default(false)
  acknowledgedAt DateTime?
  outcome String?
  createdAt DateTime @default(now())
  reviews NiceJobsPipReview[]
  @@index([assignmentId, released, status, id])
  @@index([managerId, status, reviewAt, id])
}

model NiceJobsPipReview {
  id String @id @default(cuid())
  pipId String
  pip NiceJobsPip @relation(fields: [pipId], references: [id], onDelete: Restrict)
  actorUserId String
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  kind String
  progress String?
  comment String
  privateNote String?
  evidence String
  nextAction String?
  released Boolean @default(false)
  changeSnapshot String?
  createdAt DateTime @default(now())
  @@index([pipId, released, id])
}

model NiceJobsKnowledge {
  id String @id @default(cuid())
  companyId String
  company Organization @relation(fields: [companyId], references: [id], onDelete: Restrict)
  kind String
  createdByUserId String
  creator User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  versions NiceJobsKnowledgeVersion[]
  @@index([companyId, kind])
}

model NiceJobsKnowledgeVersion {
  id String @id @default(cuid())
  contentId String
  content NiceJobsKnowledge @relation(fields: [contentId], references: [id], onDelete: Restrict)
  number Int
  revision Int @default(0)
  status String @default("DRAFT")
  current Boolean @default(false)
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  audience String
  visibility String @default("WORKER")
  jobId String?
  job NiceJobsTemplate? @relation(fields: [jobId], references: [id], onDelete: Restrict)
  jobVersionId String?
  jobVersion NiceJobsVersion? @relation(fields: [jobVersionId], references: [id], onDelete: Restrict)
  assignmentId String?
  assignment NiceJobsAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  managerId String?
  manager Person? @relation(fields: [managerId], references: [id], onDelete: Restrict)
  ownerUserId String
  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  title String
  summary String
  captions String @default("")
  transcript String @default("")
  purpose String
  body String?
  resourceType String?
  url String?
  privateReference String?
  communicationType String?
  communicationTemplateId String? @unique
  communicationTemplate CommunicationTemplate? @relation(fields: [communicationTemplateId], references: [id], onDelete: Restrict)
  relatedVersionId String?
  relatedVersion NiceJobsKnowledgeVersion? @relation("RelatedKnowledge", fields: [relatedVersionId], references: [id], onDelete: Restrict)
  relatedCommunications NiceJobsKnowledgeVersion[] @relation("RelatedKnowledge")
  requiredAck Boolean @default(false)
  priority String @default("NORMAL")
  effectiveAt DateTime?
  reviewAt DateTime?
  expiresAt DateTime?
  scheduledAt DateTime?
  reviewedByUserId String?
  reviewedAt DateTime?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  steps NiceJobsSopStep[] @relation("SopSteps")
  referencingSteps NiceJobsSopStep[] @relation("StepResource")
  receipts NiceJobsKnowledgeReceipt[]
  workLinks NiceJobsKnowledgeWorkLink[]
  @@unique([contentId, number])
  @@index([organizationId, visibility, status, current, id])
  @@index([jobId, jobVersionId, status, current])
  @@index([assignmentId, managerId, status, current])
  @@index([resourceType, status, current, id])
}

model NiceJobsContentFile {
  id String @id @default(uuid())
  companyId String
  company Organization @relation("NiceJobsFileCompany", fields: [companyId], references: [id], onDelete: Restrict)
  organizationId String
  organization Organization @relation("NiceJobsFileScope", fields: [organizationId], references: [id], onDelete: Restrict)
  uploaderUserId String
  uploader User @relation(fields: [uploaderUserId], references: [id], onDelete: Restrict)
  idempotencyKey String
  fingerprint String
  filename String
  mime String
  mediaType String
  bytes Int
  digest String
  createdAt DateTime @default(now())
  @@unique([uploaderUserId, idempotencyKey])
  @@index([companyId, organizationId, id])
}

model NiceJobsSopStep {
  id String @id @default(cuid())
  versionId String
  version NiceJobsKnowledgeVersion @relation("SopSteps", fields: [versionId], references: [id], onDelete: Restrict)
  order Int
  title String
  instruction String
  checklist String?
  warning String?
  escalation String?
  resourceVersionId String?
  resourceVersion NiceJobsKnowledgeVersion? @relation("StepResource", fields: [resourceVersionId], references: [id], onDelete: Restrict)
  taskId String?
  task Task? @relation(fields: [taskId], references: [id], onDelete: Restrict)
  @@unique([versionId, order])
}

model NiceJobsKnowledgeReceipt {
  id String @id @default(cuid())
  versionId String
  version NiceJobsKnowledgeVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  assignmentId String
  assignment NiceJobsAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  actorUserId String
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  readAt DateTime?
  acknowledgedAt DateTime?
  archivedAt DateTime?
  evidenceReference String?
  @@unique([versionId, assignmentId])
  @@index([assignmentId, readAt, acknowledgedAt, archivedAt])
}

model NiceJobsKnowledgeWorkLink {
  id String @id @default(cuid())
  versionId String
  version NiceJobsKnowledgeVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  taskId String?
  task Task? @relation(fields: [taskId], references: [id], onDelete: Restrict)
  leadId String?
  lead NiceJobsLead? @relation(fields: [leadId], references: [id], onDelete: Restrict)
  followupId String?
  followup NiceJobsLeadFollowup? @relation(fields: [followupId], references: [id], onDelete: Restrict)
  @@unique([versionId, taskId])
  @@unique([versionId, leadId])
  @@unique([versionId, followupId])
  @@index([taskId])
  @@index([leadId])
  @@index([followupId])
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model NiceJobsTemplate {
  knowledgeVersions NiceJobsKnowledgeVersion[]
  id                 String            @id @default(cuid())
  companyId          String
  company            Organization      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  productId          String
  product            Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  code               String
  status             String            @default("DRAFT")
  visibility         String            @default("INTERNAL")
  revision           Int               @default(0)
  publishedVersionId String?           @unique
  publishedVersion   NiceJobsVersion?  @relation("NiceJobsPublished", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  versions           NiceJobsVersion[] @relation("NiceJobsVersions")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status, id])
}

model NiceJobsVersion {
  incentivePolicies NiceJobsIncentivePolicy[]
  performanceFrameworks NiceJobsPerformanceFramework[]
  knowledgeVersions NiceJobsKnowledgeVersion[]
  leadEligibility NiceJobsLeadEligibility[]
  trainingPlan NiceJobsTrainingPlan?
  id            String                @id @default(cuid())
  templateId    String
  template      NiceJobsTemplate      @relation("NiceJobsVersions", fields: [templateId], references: [id], onDelete: Restrict)
  publishedFor  NiceJobsTemplate?     @relation("NiceJobsPublished")
  number        Int
  title         String
  description   String?
  engagement    String                @default("PART_TIME_INCENTIVE")
  context       String?
  configuration String?
  status        String                @default("DRAFT")
  revision      Int                   @default(0)
  publishedAt   DateTime?
  areas         NiceJobsVersionArea[]
  assignments   NiceJobsAssignment[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([templateId, number])
  @@index([templateId, status, id])
}

model NiceJobsVersionArea {
  applications NiceJobsApplication[]
  versionId  String
  version    NiceJobsVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  divisionId String
  division   Organization    @relation(fields: [divisionId], references: [id], onDelete: Restrict)

  @@id([versionId, divisionId])
  @@index([divisionId, versionId])
}

model NiceJobsWorkerProfile {
  id          String               @id @default(cuid())
  personId    String
  person      Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  companyId   String
  company     Organization         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments NiceJobsAssignment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([companyId, personId])
}

model NiceJobsAssignment {
  incentiveEarnings NiceJobsIncentiveEarning[]
  wallets NiceJobsWallet[]
  performanceSnapshots NiceJobsPerformanceSnapshot[]
  pips NiceJobsPip[]
  knowledgeVersions NiceJobsKnowledgeVersion[]
  knowledgeReceipts NiceJobsKnowledgeReceipt[]
  ownedLeads NiceJobsLead[]
  leadAssignments NiceJobsLeadAssignment[]
  leadActivities NiceJobsLeadActivity[]
  leadFollowups NiceJobsLeadFollowup[]
  onboardingId String? @unique
  onboarding NiceJobsOnboarding? @relation(fields: [onboardingId], references: [id], onDelete: Restrict)
  readinessReviewId String? @unique
  readinessReview NiceJobsTrainingReview? @relation(fields: [readinessReviewId], references: [id], onDelete: Restrict)
  activatedAt DateTime?
  activatedByUserId String?
  activatedBy User? @relation("WorkerActivationActor", fields: [activatedByUserId], references: [id], onDelete: Restrict)
  tasks Task[]
  blockers ExecutionBlocker[]
  dailyReports NiceJobsDailyReport[]
  id         String                @id @default(cuid())
  profileId  String
  profile    NiceJobsWorkerProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  versionId  String
  version    NiceJobsVersion       @relation(fields: [versionId], references: [id], onDelete: Restrict)
  divisionId String
  division   Organization          @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  managerId  String?
  manager    Person?               @relation("NiceJobsManager", fields: [managerId], references: [id], onDelete: Restrict)
  status     String                @default("PREPARED")
  lifecycle  String                @default("APPLICANT")
  revision   Int                   @default(0)
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([profileId, versionId, divisionId])
  @@index([divisionId, status, id])
  @@index([divisionId, id])
  @@index([divisionId, lifecycle, id])
  @@index([profileId, status, id])
  @@index([versionId, id])
  @@index([managerId, status, id])
}

model NiceJobsDailyReport {
  id String @id @default(cuid())
  assignmentId String
  assignment NiceJobsAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  reportDate String
  timezone String
  revision Int @default(0)
  supersedesId String? @unique
  supersedes NiceJobsDailyReport? @relation("ReportCorrection", fields: [supersedesId], references: [id], onDelete: Restrict)
  correction NiceJobsDailyReport? @relation("ReportCorrection")
  taskSnapshot String
  operationalSnapshot String?
  blockerSnapshot String
  notes String?
  correctionReason String?
  submittedByUserId String
  submittedBy User @relation(fields: [submittedByUserId], references: [id], onDelete: Restrict)
  submittedByPersonId String
  submittedAt DateTime @default(now())
  @@unique([assignmentId, reportDate, revision])
  @@index([assignmentId, reportDate, id])
}

model NiceJobsLeadPolicy {
  id String @id @default(cuid())
  companyId String
  company Organization @relation("LeadPolicyCompany", fields: [companyId], references: [id], onDelete: Restrict)
  divisionId String
  division Organization @relation("LeadPolicyDivision", fields: [divisionId], references: [id], onDelete: Restrict)
  name String
  definitionId String
  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  status String @default("ACTIVE")
  allowedSources String
  followupRequiredStates String
  claimAllowed Boolean @default(false)
  unassignAllowed Boolean @default(false)

model NexaDirective {
  id String @id @default(cuid())
  nexaId String
  nexa NexaIdentity @relation(fields: [nexaId], references: [id], onDelete: Restrict)
  bossUserId String
  boss User @relation("NexaBoss", fields: [bossUserId], references: [id], onDelete: Restrict)
  directorUserId String
  director User @relation("NexaDirector", fields: [directorUserId], references: [id], onDelete: Restrict)

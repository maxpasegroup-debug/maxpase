model WorkflowDefinition {
  leadPolicies NiceJobsLeadPolicy[]
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projectId      String?
  scopeKey       String
  key            String
  version        Int
  name           String
  description    String?
  status         String               @default("DRAFT")
  states         WorkflowState[]
  transitions    WorkflowTransition[]
  instances      WorkflowInstance[]
  recurringWork  RecurringWork[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, scopeKey, key, version])
}

model WorkflowState {
  id              String               @id @default(cuid())
  definitionId    String
  definition      WorkflowDefinition   @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  key             String
  name            String
  initial         Boolean              @default(false)
  terminal        Boolean              @default(false)
  fromTransitions WorkflowTransition[] @relation("WorkflowFrom")
  toTransitions   WorkflowTransition[] @relation("WorkflowTo")
  instances       WorkflowInstance[]

  @@unique([definitionId, key])
}

model WorkflowTransition {
  id                 String             @id @default(cuid())
  definitionId       String
  definition         WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  key                String
  fromStateId        String
  fromState          WorkflowState      @relation("WorkflowFrom", fields: [fromStateId], references: [id], onDelete: Restrict)
  toStateId          String
  toState            WorkflowState      @relation("WorkflowTo", fields: [toStateId], references: [id], onDelete: Restrict)
  requiredPermission String
  requireReason      Boolean            @default(false)
  controlPointId     String?
  controlPoint       ControlPoint?      @relation(fields: [controlPointId], references: [id], onDelete: Restrict)
  history            WorkflowHistory[]

  @@unique([definitionId, key])
}

model WorkflowInstance {
  lead NiceJobsLead?
  id             String               @id @default(cuid())
  definitionId   String
  definition     WorkflowDefinition   @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projectId      String?
  resourceType   String
  resourceId     String
  title          String
  creatorUserId  String
  creator        User                 @relation(fields: [creatorUserId], references: [id], onDelete: Restrict)
  currentStateId String
  currentState   WorkflowState        @relation(fields: [currentStateId], references: [id], onDelete: Restrict)
  version        Int                  @default(0)
  status         String               @default("PENDING")
  idempotencyKey String
  fingerprint    String
  history        WorkflowHistory[]
  requests       OperationalRequest[]
  checks         ControlCheck[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([creatorUserId, idempotencyKey])
  @@index([organizationId, projectId, status])
}

model WorkflowHistory {
  id              String             @id @default(cuid())
  instanceId      String
  instance        WorkflowInstance   @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  transitionId    String
  transition      WorkflowTransition @relation(fields: [transitionId], references: [id], onDelete: Restrict)
  actorUserId     String
  actor           User               @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  fromState       String
  toState         String
  reason          String?
  instanceVersion Int
  idempotencyKey  String
  fingerprint     String
  createdAt       DateTime           @default(now())

  @@unique([instanceId, idempotencyKey])
  @@unique([instanceId, instanceVersion])
}


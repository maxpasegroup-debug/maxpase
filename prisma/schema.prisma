  entityId          String
  status            String             @default("SUCCEEDED")
  reference         String             @unique
  correlationId     String?
  metadata          String?
  auditId           String             @unique
  audit             AuditEvent         @relation(fields: [auditId], references: [id], onDelete: Restrict)
